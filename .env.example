# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_products,write_products,read_inventory,write_inventory,read_themes
SHOPIFY_APP_URL=https://restockping.vercel.app

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.sqlite"

# Transactional Email Provider (Resend or Postmark API Key for production emails)
RESEND_API_KEY=re_1234567890
EMAIL_FROM="alerts@restockping.com"

# Web Push VAPID Keys (Optional for push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@restockping.com"

# Node Environment
NODE_ENV=development
PORT=3000
